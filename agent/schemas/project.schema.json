{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "project_context",
  "type": "object",
  "required": [
    "project_id",
    "created_at",
    "tools",
    "status"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^PRJ_[A-Za-z0-9_]+$"
    },
    "created_at": {
      "type": "string"
    },
    "status": {
      "enum": [
        "DRAFT",
        "ANALYZING",
        "IN_PROGRESS",
        "BLOCKED",
        "VERIFIED"
      ]
    },
    "client": {
      "type": [
        "object",
        "null"
      ]
    },
    "site": {
      "type": [
        "object",
        "null"
      ]
    },
    "tools": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "available"
        ],
        "properties": {
          "available": {
            "type": "boolean"
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "human_gate_required": {
      "type": "boolean"
    }
  }
}
